# Database Connection (MongoDB)
# Local: "mongodb://127.0.0.1:27017/vibecode"
# Cloud Atlas: "mongodb+srv://<username>:<password>@cluster0.mongodb.net/vibecode?retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/vibecode?retryWrites=true&w=majority"

# NextAuth Configuration
AUTH_SECRET="change_me_to_a_random_32_character_secret"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth Provider
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth Provider
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ==========================================
# AI Provider Configuration (Code Suggestions & Chat)
# ==========================================
# Options: "grok" | "groq" | "openai" | "gemini" | "ollama"
# Leave blank to auto-detect based on whichever key is provided.
AI_PROVIDER=""

# 1. Grok (xAI) - High reasoning accuracy
# Get your API key from https://console.x.ai
GROK_API_KEY=""
GROK_MODEL="grok-2"

# 2. Groq - Recommended for super-fast autocomplete (<150ms response time)
# Get your free API key from https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="qwen-2.5-coder-32b"

# 3. OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 4. Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# 5. Ollama (Local AI fallback)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="codellama"
